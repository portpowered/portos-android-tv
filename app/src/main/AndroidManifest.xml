<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A TV app on purpose: it should not be offered to phones or Chromebooks. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true"
        tools:ignore="UnsupportedChromeOsHardware" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Lets the app open YouTube or Spotify when a command arrives in the background. Granted once through
         adb (make setup-tv): Google TV has no settings screen for it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.spotify.tv.android" />
        <!-- The launchable apps: what application-list reports and launch-application can open. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".PortOsApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PortOs"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Text notifications: a translucent card over whatever is playing. Started only by the app itself, from
             the background-launch path, and kept out of Recents. -->
        <activity
            android:name=".ui.NotificationActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.PortOs.Notification" />

        <!-- The generative UI surface an agent draws. Started only by the app itself, from the background-launch
             path, in its own task; Back and Home send it behind the launcher without closing the surface. -->
        <activity
            android:name=".surface.SurfaceActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.PortOs.Surface" />

        <!-- The player screen for play-uri, play-video and play-audio. Started only by PlaybackService, in its own
             task so closing it returns to the app that was showing; it closes itself when playback ends. -->
        <activity
            android:name=".ui.PlayerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.PortOs.Player" />

        <!-- play-uri audio and play-video and play-audio files. Media3 keeps it in the foreground, with a
             notification, while they play. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Firebase is initialized from BuildConfig in PortOsApplication (no google-services.json), so the
             default init provider would only log a failed attempt. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <service
            android:name=".messaging.PortOsMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".state.MediaSessionListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Remote buttons and screen capture. Enabled through adb (make setup-tv); never reads window content
             beyond finding the focused control. -->
        <service
            android:name=".control.PortOsAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
